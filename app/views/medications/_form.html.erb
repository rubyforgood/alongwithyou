<%= form_with(model: medication) do |form| %>
  <% if medication.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(medication.errors.count, "error") %> prohibited this medication from being saved:</h2>

      <ul>
        <% medication.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :medication_type_id, "Medication type", style: "display: block" %>
    <%= form.collection_select :medication_type_id, MedicationType.order(:name), :id, :name, include_blank: true %>
  </div>

  <div>
    <%= form.label :side_effects, style: "display: block" %>
    <%= form.textarea :side_effects %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
