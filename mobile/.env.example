# Copy to .env to override where the app looks for the Rails API.
#
# You usually do NOT need this in development: src/lib/api.ts derives the URL
# from the Metro bundler host, which already works for simulators, emulators
# and physical devices on the same network.
#
# You DO need it for release builds, and whenever Rails is not on port 3000 of
# the machine running Metro (a tunnel, a staging box, Docker, WSL2 port
# forwarding, and so on).
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time.
# Treat it as public: never put API keys or secrets here.

EXPO_PUBLIC_API_URL=http://localhost:3000
